---
import { Image } from 'astro:assets';
import { inlineMarkdown } from '../i18n/inlineMarkdown.js';

// Una función de «qué puedes hacer»: una idea por bloque (título + una frase) y,
// si hay captura, la captura grande. La lista completa queda un nivel más abajo,
// en «Ver detalles», para que lo primero que se lea sea lo esencial.
const { title, summary, items, more, image = null, alt = '', caption = '', flip = false } = Astro.props;
---

<article class={image ? `frow${flip ? ' frow--flip' : ''}` : 'tile'}>
  <div class="frow__text">
    <h3 class="h3">{title}</h3>
    <p class="frow__summary">{summary}</p>
    <details class="more">
      <summary>{more}</summary>
      <ul class="ticks">
        {items.map((it) => <li set:html={inlineMarkdown(it)} />)}
      </ul>
    </details>
  </div>
  {
    image && (
      <figure class="frow__shot">
        <Image src={image} alt={alt} width={900} loading="lazy" sizes="(max-width: 900px) 94vw, 620px" />
        <figcaption>{caption}</figcaption>
      </figure>
    )
  }
</article>
