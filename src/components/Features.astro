---
import FeatureRow from './FeatureRow.astro';
import { screenshots } from '../assets/screenshots.js';
import { t } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const c = t(lang).features;
const shots = screenshots[lang];

// Primero las funciones que se entienden mejor viéndolas (con captura);
// después, en una rejilla de tarjetas, el resto.
const showcase = [
  { f: c.errors, image: shots.assistant },
  { f: c.debug, image: shots.debugger, flip: true },
  { f: c.console, image: shots.console },
  { f: c.files, image: shots.fileMenu, flip: true },
];
const tiles = [c.run, c.project, c.terminal, c.fast];
---

<section class="section" id="que-puedes-hacer" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="h2" id="features-title">{c.title}</h2>
    </div>

    <div class="features">
      {
        showcase.map(({ f, image, flip }) => (
          <FeatureRow
            title={f.t}
            summary={f.s}
            items={f.items}
            more={c.more}
            image={image}
            alt={f.alt ?? f.caption}
            caption={f.caption}
            flip={flip}
          />
        ))
      }
    </div>

    <p class="features__also">{c.alsoTitle}</p>
    <div class="tiles">
      {tiles.map((f) => <FeatureRow title={f.t} summary={f.s} items={f.items} more={c.more} />)}
    </div>
  </div>
</section>
