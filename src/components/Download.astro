---
import SafetyNotice from './SafetyNotice.astro';
import { inlineMarkdown } from '../i18n/inlineMarkdown.js';
import { t, routes, project } from '../i18n/index.js';

const { lang = 'es' } = Astro.props;
const c = t(lang).download;
const r = routes[lang];

// La primera variante es la recomendada: va destacada, con el botón principal.
// El resto, una tarjeta por opción, cada una con su propia acción.
const [featured, ...others] = c.rows;
---

<section class="section" id="descargar" aria-labelledby="download-title">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="h2" id="download-title">{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <p class="versiontag">{c.version}</p>

    <div class="variant variant--featured">
      <div>
        {featured.tag && <span class="pill">{featured.tag}</span>}
        <h3 class="h3 variant__name">{featured.name}</h3>
        <p class="variant__includes">{featured.includes}</p>
        <p class="variant__who">{featured.who}</p>
      </div>
      <div class="variant__action">
        <a class="btn btn--lg" href={project.releasesUrl} rel="noopener">{c.button}</a>
        <p class="variant__size">{featured.files.join(' ')}</p>
      </div>
    </div>

    <ul class="variants">
      {
        others.map((v) => (
          <li class="variant">
            <h3 class="h3 variant__name">{v.name}</h3>
            <p class="variant__includes">{v.includes}</p>
            <p class="variant__who">{v.who}</p>
            <p class="variant__size">{v.files.join(' ')}</p>
            <a class="link variant__link" href={project.releasesUrl} rel="noopener">{c.cardLink}</a>
          </li>
        ))
      }
    </ul>

    <div class="download__cols">
      <div>
        <h3 class="h3">{c.systemsTitle}</h3>
        <ul class="ticks">
          {c.systems.map((s) => <li set:html={inlineMarkdown(s)} />)}
        </ul>
      </div>
      <div class="download__cta">
        <p class="muted">{c.webview}</p>
        <p class="muted">{c.buttonNote}</p>
        <a class="link" href={r.manual}>{c.manualLink}</a>
      </div>
    </div>

    <SafetyNotice lang={lang} />
  </div>
</section>
